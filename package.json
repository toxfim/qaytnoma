{
  "name": "barcodeer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uzum Market qaytarim hujjatlarini skanerdan Google Sheets'ga avtomatik ko'chirish",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit false --pretty",
    "dev": "pnpm --filter @barcodeer/tray dev",
    "front": "pnpm --filter @barcodeer/landing dev",
    "scan": "pnpm --filter @barcodeer/core cli scan",
    "ingest": "pnpm --filter @barcodeer/core cli ingest",
    "lint": "prettier --check \"**/*.{ts,json,md}\"",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "build:installer": "pnpm build && node scripts/build-installer.mjs",
    "deploy:landing": "ssh root@139.162.197.219 \"bash ~/projects/qaytnoma/scripts/deploy-landing.sh\"",
    "deploy:installer": "scp apps/landing/public/download/meta.json apps/landing/public/download/qaytnoma-setup.exe root@139.162.197.219:/var/www/qaytnoma.tez-agent.uz/download/"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "electron-builder": "^26.0.12"
  }
}
